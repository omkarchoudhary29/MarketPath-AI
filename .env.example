# ==============================================================================
# MarketPath AI — Environment Configuration Template
# ==============================================================================
# Copy this file to .env and fill in real values.
# NEVER commit .env to version control or expose production secrets.

# --- APPLICATION ENVIRONMENT ---
APP_ENV=development                       # development | staging | production | testing
PROJECT_NAME="MarketPath AI"
API_V1_PREFIX="/api/v1"
PORT=8000                                 # Dynamically provided by Railway as $PORT

# --- NETWORKING & CORS ---
FRONTEND_URL="http://localhost:5173"
BACKEND_URL="http://localhost:8000"
# JSON-encoded array of allowed origins for CORS (Railway up.railway.app domains supported automatically)
ALLOWED_ORIGINS='["http://localhost:5173", "http://127.0.0.1:5173", "http://localhost:3000", "http://localhost:8000"]'

# --- DATABASE CONFIGURATION ---
# Development: SQLite (default fallback)
DATABASE_URL="sqlite+aiosqlite:///./marketpath.db"
# Railway PostgreSQL: Railway automatically injects DATABASE_URL into your service.
# MarketPath automatically transforms "postgresql://" or "postgres://" to "postgresql+asyncpg://".
# DATABASE_URL="postgresql+asyncpg://postgres:[PASSWORD]@[HOST]:[PORT]/[DATABASE]"

# --- SECURITY & CRYPTOGRAPHY ---
# Application secret key for session/CSRF state signing (minimum 32 characters)
SECRET_KEY="generate-a-secure-random-secret-key-min-32-chars"
# Base64-encoded 32-byte AES-GCM key for encrypting third-party tokens at rest
# Generate with: openssl rand -base64 32
ENCRYPTION_MASTER_KEY="MDEyMzQ1Njc4OTAxMjM0NTY3ODkwMTIzNDU2Nzg5MDE="

# --- GITHUB REPOSITORY INTEGRATION ---
VITE_GITHUB_REPO_URL="https://github.com/omkarchoudhary29/marketpath-ai"

# --- DEMO CREDENTIAL OVERRIDES (OPTIONAL) ---
DEMO_ACCOUNTS_ENABLED=true
DEMO_PASSWORD_COMPANY="AuraTerra#Demo2026!"
DEMO_PASSWORD_AGENCY="CraftVerve#Demo2026!"
DEMO_PASSWORD_CONSULTANT="DrSharma#Demo2026!"
DEMO_PASSWORD_ADMIN="Admin#Platform2026!"

# --- GOOGLE GEMINI AI ---
# Get an API key from Google AI Studio (https://aistudio.google.com/)
GEMINI_API_KEY="your-google-gemini-api-key"
GEMINI_MODEL="gemini-2.5-flash"

# --- CLOUDINARY MEDIA STORAGE ---
# Get credentials from Cloudinary Console (https://cloudinary.com/console)
CLOUDINARY_CLOUD_NAME="your-cloudinary-cloud-name"
CLOUDINARY_API_KEY="your-cloudinary-api-key"
CLOUDINARY_API_SECRET="your-cloudinary-api-secret"

# --- SHOPIFY APP INTEGRATION ---
# From Shopify Partners Dashboard -> Apps -> App Setup
SHOPIFY_CLIENT_ID="your-shopify-app-api-key"
SHOPIFY_CLIENT_SECRET="your-shopify-app-client-secret"
SHOPIFY_APP_URL="http://localhost:8000"
SHOPIFY_REDIRECT_URI="http://localhost:8000/api/v1/integrations/shopify/callback"
SHOPIFY_SCOPES="read_products,write_products,read_inventory,write_inventory,read_orders"

# --- META GRAPH & INSTAGRAM / META ADS ---
# From Meta for Developers -> App Dashboard
META_APP_ID="your-meta-app-id"
META_APP_SECRET="your-meta-app-secret"
META_REDIRECT_URI="http://localhost:8000/api/v1/integrations/instagram/callback"
META_WEBHOOK_VERIFY_TOKEN="your-custom-webhook-verify-token"

# --- TRANSACTIONAL EMAIL NOTIFICATIONS (OPTIONAL) ---
SMTP_HOST="smtp.sendgrid.net"
SMTP_PORT=587
SMTP_USER="apikey"
SMTP_PASSWORD="your-smtp-password"
SMTP_FROM_EMAIL="notifications@marketpath.ai"
EMAIL_PROVIDER="smtp"                     # smtp | brevo | resend | sendgrid
